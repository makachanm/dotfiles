environment {
    QT_QUICK_CONTROLS_STYLE "org.kde.desktop"
    GTK_IM_MODULE "kime"
    QT_IM_MODULE "kime"
    QT_IM_MODULES "wayland;kime"
    XMODIFIERS "@im=kime"
    SDL_IM_MODULE "kime"
    GLFW_IM_MODULE "kime"
    INPUT_METHOD "kime"
}

spawn-sh-at-startup "systemctl --user import-environment WAYLAND_DISPLAY NIRI_SOCKET XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE QT_QPA_PLATFORMTHEME && systemctl --user start lxqt-niri-session.target; lxqt-session && systemctl --user stop lxqt-niri-session.target && niri msg action quit -s"
spawn-at-startup "tailscale" "systray"
spawn-at-startup "nm-applet" "--indicator"
spawn-at-startup "swayidle" "-w" "timeout" "400" "niri msg action power-off-monitors" "timeout" "405" "swaylock -f -c 000000" "timeout" "1000" "systemctl suspend" "before-sleep" "swaylock -f -c 000000"
spawn-at-startup "udiskie" "--automount" "--no-notify" "--no-tray"

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

include "../../niri/common.kdl"

window-rule {
    match app-id="^lxqt-(config.*|leave|runner|policykit-agent)$"
    open-floating true
}

debug {
    honor-xdg-activation-with-invalid-serial
    dbus-interfaces-in-non-session-instances
}

binds {
    Mod+Space { spawn "rofi" "-show" "drun"; }
    Mod+Comma { spawn "lxqt-config"; }
    Mod+F { screenshot; }
    Mod+Shift+F { screenshot-screen; }

    Mod+L { spawn "lxqt-leave" "--lockscreen"; }
    Mod+Shift+Escape { spawn "lxqt-leave"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "lxqt-qdbus" "volume" "up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "lxqt-qdbus" "volume" "down"; }
    XF86AudioMute allow-when-locked=true { spawn "lxqt-qdbus" "volume" "mute"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "lxqt-config-brightness" "-i"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "lxqt-config-brightness" "-d"; }
}
