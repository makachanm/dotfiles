configuration {
    modes: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    font: "IBM Plex Sans KR 11";
    terminal: "qterminal";
    drun-display-format: "{name}";
    display-drun: "앱";
    display-run: "명령";
    display-window: "창";
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
}

@theme "Mono"
