#!/usr/bin/env python3
# 폴더(경로나 file:// URI)를 Gnome Commander 왼쪽 창에 새 창으로 연다.
# 파일을 받으면 그 파일이 있는 폴더를 연다.
# 이미 떠 있는 창에는 폴더를 넘길 수 없어서, allow-multiple-instances를 켜 두고 새로 띄운다.
import os
import subprocess
import sys
from urllib.parse import unquote, urlparse

args = []
if len(sys.argv) > 1:
    target = sys.argv[1]
    if target.startswith("file://"):
        target = unquote(urlparse(target).path)
    if not os.path.isdir(target):
        target = os.path.dirname(target) or os.path.expanduser("~")
    args = ["--start-left-dir", target]

subprocess.Popen(["gnome-commander", *args], start_new_session=True,
                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
