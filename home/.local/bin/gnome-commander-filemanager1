#!/usr/bin/env python3
# org.freedesktop.FileManager1 브리지: 다른 앱의 "폴더에서 보기" 요청을 Gnome Commander로 연다.
# (Gnome Commander는 이 서비스를 제공하지 않음)
import os
import subprocess
from gi.repository import Gio, GLib

XML = """
<node>
  <interface name="org.freedesktop.FileManager1">
    <method name="ShowFolders"><arg type="as" name="URIs" direction="in"/><arg type="s" name="StartupId" direction="in"/></method>
    <method name="ShowItems"><arg type="as" name="URIs" direction="in"/><arg type="s" name="StartupId" direction="in"/></method>
    <method name="ShowItemProperties"><arg type="as" name="URIs" direction="in"/><arg type="s" name="StartupId" direction="in"/></method>
  </interface>
</node>
"""
OPEN = os.path.expanduser("~/.local/bin/gnome-commander-open")
IDLE_EXIT_MS = 60_000
loop = GLib.MainLoop()
timer = None


def rearm():
    global timer
    if timer:
        GLib.source_remove(timer)
    timer = GLib.timeout_add(IDLE_EXIT_MS, loop.quit)


def on_call(conn, sender, path, iface, method, params, invocation):
    uris, _startup_id = params.unpack()
    # ShowItems도 파일이 있는 폴더를 연다 (Gnome Commander는 항목 선택을 지원하지 않음)
    for uri in dict.fromkeys(uris):
        subprocess.run([OPEN, uri])
    invocation.return_value(None)
    rearm()


def on_bus(conn, name):
    node = Gio.DBusNodeInfo.new_for_xml(XML)
    conn.register_object("/org/freedesktop/FileManager1", node.interfaces[0], on_call)


Gio.bus_own_name(Gio.BusType.SESSION, "org.freedesktop.FileManager1",
                 Gio.BusNameOwnerFlags.REPLACE, on_bus, None, lambda *_: loop.quit())
rearm()
loop.run()
