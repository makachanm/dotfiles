#!/usr/bin/env bash
set -euo pipefail

pins="${XDG_CONFIG_HOME:-$HOME/.config}/rofi/pinned"

if [ -z "${ROFI_RETV:-}" ]; then
    exec rofi -show apps -modi "apps:$0" -show-icons "$@"
fi

if [ "$ROFI_RETV" = 1 ] && [ -n "${ROFI_INFO:-}" ]; then
    setsid -f gtk-launch "${ROFI_INFO%.desktop}" >/dev/null 2>&1 </dev/null
    exit 0
fi

list_apps() {
    local dir file
    local IFS=:
    for dir in "${XDG_DATA_HOME:-$HOME/.local/share}" ${XDG_DATA_DIRS:-/usr/local/share:/usr/share}; do
        [ -d "$dir/applications" ] || continue
        find -L "$dir/applications" -name '*.desktop' -printf "$dir/applications\t%P\n"
    done | awk -F'\t' '!seen[$2]++ { print $1 "/" $2 "\t" $2 }' |
    while IFS=$'\t' read -r file id; do
        awk -v id="${id//\//-}" -v desktop="${XDG_CURRENT_DESKTOP:-}" '
            /^\[/ { section = $0; next }
            section != "[Desktop Entry]" { next }
            /^Name=/ && name == "" { name = substr($0, 6) }
            /^Icon=/ { icon = substr($0, 6) }
            /^Type=/ { type = substr($0, 6) }
            /^(NoDisplay|Hidden)=true/ { hide = 1 }
            /^OnlyShowIn=/ { only = substr($0, 12) }
            /^NotShowIn=/ { if (desktop != "" && index(";" substr($0, 11), ";" desktop ";")) hide = 1 }
            END {
                if (only != "" && (desktop == "" || !index(";" only, ";" desktop ";"))) hide = 1
                if (type == "Application" && name != "" && !hide) print id "\t" name "\t" icon
            }
        ' "$file"
    done
}

apps="$(list_apps)"

printf '\0no-custom\037true\n'

{
    if [ -f "$pins" ]; then
        grep -v '^[[:space:]]*\(#\|$\)' "$pins" | sed 's/[[:space:]]*$//; /\.desktop$/!s/$/.desktop/' |
        while read -r id; do
            printf '%s\n' "$apps" | awk -F'\t' -v id="$id" '$1 == id { print; exit }'
        done
    fi
    printf '%s\n' "$apps" | sort -t$'\t' -k2,2f
} | awk -F'\t' '$1 != "" && !seen[$1]++ { printf "%s\0icon\037%s\037info\037%s\n", $2, $3, $1 }'
