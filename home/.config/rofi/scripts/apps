#!/usr/bin/env python3
import os
import subprocess
import sys

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio

try:
    gi.require_version("GioUnix", "2.0")
    from gi.repository import GioUnix

    DesktopAppInfo = GioUnix.DesktopAppInfo
except (ImportError, ValueError):
    DesktopAppInfo = Gio.DesktopAppInfo

CONFIG = os.path.expanduser("~/.config/rofi/pinned")
HISTORY = os.path.expanduser("~/.cache/rofi3.druncache")


def read_lines(path):
    try:
        with open(path) as f:
            return [line.strip() for line in f if line.strip()]
    except FileNotFoundError:
        return []


def read_pins():
    return read_lines(CONFIG)


def write_pins(pins):
    with open(CONFIG, "w") as f:
        f.writelines(p + "\n" for p in pins)


def read_history():
    history = {}
    for line in read_lines(HISTORY):
        count, _, app_id = line.partition(" ")
        if count.isdigit() and app_id:
            history[app_id] = int(count)
    return history


def bump_history(app_id):
    history = read_history()
    history[app_id] = history.get(app_id, 0) + 1
    ordered = sorted(history.items(), key=lambda kv: -kv[1])
    os.makedirs(os.path.dirname(HISTORY), exist_ok=True)
    with open(HISTORY, "w") as f:
        f.writelines(f"{count} {app_id}\n" for app_id, count in ordered)


def apps():
    found = {}
    for app in Gio.AppInfo.get_all():
        if isinstance(app, DesktopAppInfo) and app.should_show():
            found[app.get_id()] = app
    return found


def row(app):
    fields = [("info", app.get_id())]
    icon = app.get_icon()
    if icon:
        fields.append(("icon", icon.to_string()))
    keywords = [app.get_generic_name() or "", *(app.get_keywords() or [])]
    fields.append(("meta", " ".join(k for k in keywords if k)))
    meta = "\x1f".join(f"{k}\x1f{v}" for k, v in fields)
    return f"{app.get_display_name()}\0{meta}"


def show():
    available = apps()
    history = read_history()
    pins = [p for p in read_pins() if p in available]
    rest = sorted(
        (a for a in available if a not in pins),
        key=lambda a: (-history.get(a, 0), available[a].get_display_name().lower()),
    )
    print("\0prompt\x1fapps")
    print("\0message\x1fAlt+P  pin / unpin")
    print("\0no-custom\x1ftrue")
    print("\0use-hot-keys\x1ftrue")
    print("\0keep-selection\x1ftrue")
    if pins:
        print(f"\0active\x1f0-{len(pins) - 1}")
    for app_id in pins + rest:
        print(row(available[app_id]))


def toggle_pin(app_id):
    pins = read_pins()
    if app_id in pins:
        pins.remove(app_id)
    else:
        pins.append(app_id)
    write_pins(pins)


def launch(app_id):
    bump_history(app_id)
    subprocess.Popen(
        ["gtk-launch", app_id.removesuffix(".desktop")],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def main():
    retv = int(os.environ.get("ROFI_RETV", "0"))
    app_id = os.environ.get("ROFI_INFO", "")
    if retv == 1 and app_id:
        launch(app_id)
        return
    if retv == 10 and app_id:
        toggle_pin(app_id)
    show()


if __name__ == "__main__":
    sys.exit(main())
