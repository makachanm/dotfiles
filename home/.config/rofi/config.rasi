configuration {
    modi: "apps:~/.config/rofi/scripts/apps,drun,run,window";
    kb-custom-1: "Alt+p";
    font: "Pretendard SemiBold 10";
    show-icons: false;
    terminal: "foot";
    drun-display-format: "{name}";
    location: 0;
    disable-history: false;
}

@theme "/dev/null"

* {
    bg: #000000;
    bg-input: #141414;
    bg-selected: #444444;
    fg: #ffffff;
    fg-dim: #888888;
    border-col: #444444;

    background-color: transparent;
    text-color: @fg;
    margin: 0px;
    padding: 0px;
}

window {
    background-color: @bg;
    border: 1px;
    border-color: @border-col;
    border-radius: 0px;
    width: 450px;
    padding: 12px;
}

mainbox {
    children: [ inputbar, message, listview ];
    spacing: 8px;
}

inputbar {
    children: [ prompt, entry ];
    background-color: @bg-input;
    border: 1px;
    border-color: @border-col;
    border-radius: 0px;
    padding: 6px;
}

prompt {
    text-color: @fg-dim;
    padding: 0px 8px 0px 2px;
}

entry {
    text-color: @fg;
    placeholder: "Search...";
    placeholder-color: @fg-dim;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: false;
    spacing: 2px;
}

element {
    padding: 6px 8px;
    border-radius: 0px;
}

element selected {
    background-color: @bg-selected;
    text-color: @fg;
}

element-text {
    text-color: inherit;
}

message {
    padding: 0px 2px;
}

textbox {
    text-color: @fg-dim;
}

element normal.active,
element alternate.active {
    border: 0px 0px 0px 2px;
    border-color: @fg;
    text-color: @fg;
}

element selected.active {
    border: 0px 0px 0px 2px;
    border-color: @fg;
    background-color: @bg-selected;
    text-color: @fg;
}


element-icon {
    margin: 0px 8px 0px 0px;
}
