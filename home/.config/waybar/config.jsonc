{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 4,
    "modules-left": ["niri/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "power-profiles-daemon", "cpu", "battery", "custom/notification"],

    "clock": {
        "format": "{:%Y-%m-%d %a %H:%M}",
        "tooltip-format": "<tt><big>{calendar}</big></tt>"
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip": true,
        "tooltip-format": "Profile: {profile}\nDriver: {driver}",
        "format-icons": {
            "default": "BAL",
            "performance": "POW",
            "balanced": "BAL",
            "power-saver": "SAV"
        }
    },
    "cpu": {
        "format": "CPU {usage}%"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "BAT {capacity}%",
        "format-charging": "CHG {capacity}%",
        "format-plugged": "PLG {capacity}%"
    },
    "custom/notification": {
        "format": "⁝⁝",
        "tooltip": false,
        "escape": true,
        "on-click": "swaync-client -t -sw"
    }
}
