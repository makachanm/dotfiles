#!/usr/bin/env python3
import json
import subprocess
import sys

mode = sys.argv[1] if len(sys.argv) > 1 else "next"
move = mode == "move"
step = -1 if mode == "prev" else 1

workspaces = json.loads(subprocess.run(
    ["niri", "msg", "-j", "workspaces"], capture_output=True, text=True, check=True
).stdout)

current = next((w for w in workspaces if w["is_focused"]), None)
if current is None:
    sys.exit(0)

on_output = sorted(
    (w for w in workspaces if w["output"] == current["output"]), key=lambda w: w["idx"]
)
ring = [w for w in on_output if w["active_window_id"] is not None or w is current]
if move and on_output[-1] not in ring:
    windows = json.loads(subprocess.run(
        ["niri", "msg", "-j", "windows"], capture_output=True, text=True, check=True
    ).stdout)
    columns = {
        (w["layout"]["pos_in_scrolling_layout"] or [None])[0]
        for w in windows
        if w["workspace_id"] == current["id"]
    }
    if len(columns) > 1:
        ring.append(on_output[-1])
if len(ring) < 2:
    sys.exit(0)

pos = next(i for i, w in enumerate(ring) if w is current)
target = ring[(pos + step) % len(ring)]
action = "move-column-to-workspace" if move else "focus-workspace"
subprocess.run(["niri", "msg", "action", action, str(target["idx"])], check=True)
