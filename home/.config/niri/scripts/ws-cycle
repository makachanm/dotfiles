#!/usr/bin/env python3
import json
import subprocess
import sys

step = -1 if len(sys.argv) > 1 and sys.argv[1] == "prev" else 1

workspaces = json.loads(subprocess.run(
    ["niri", "msg", "-j", "workspaces"], capture_output=True, text=True, check=True
).stdout)

current = next((w for w in workspaces if w["is_focused"]), None)
if current is None:
    sys.exit(0)

on_output = sorted(
    (w for w in workspaces if w["output"] == current["output"]), key=lambda w: w["idx"]
)
ring = [w for w in on_output if w["active_window_id"] is not None or w is current]
if len(ring) < 2:
    sys.exit(0)

pos = next(i for i, w in enumerate(ring) if w is current)
target = ring[(pos + step) % len(ring)]
subprocess.run(["niri", "msg", "action", "focus-workspace", str(target["idx"])], check=True)
