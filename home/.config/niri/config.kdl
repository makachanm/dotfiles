spawn-at-startup "kime"
spawn-at-startup "waybar"
spawn-at-startup "swaync"
spawn-at-startup "swaybg" "-i" "/home/maka/Pictures/wallpaper/rei-bg.png" "-m" "fill"
spawn-at-startup "swayidle" "-w" \
    "timeout" "400" "niri msg action power-off-monitors" \
    "timeout" "405" "loginctl lock-session" \
    "timeout" "1000" "systemctl suspend" \
    "before-sleep" "loginctl lock-session; sleep 1" \
    "lock" "pidof hyprlock || hyprlock &"
spawn-at-startup "/usr/libexec/lxqt-policykit-agent"
spawn-at-startup "blueman-applet"
spawn-at-startup "nm-applet"
spawn-at-startup "pasystray" "--notify=none"
spawn-at-startup "tailscale" "systray"
spawn-at-startup "wl-paste" "--watch" "cliphist" "store"
spawn-at-startup "udiskie"
spawn-sh-at-startup "mpvpaper -s -a full -o 'no-audio loop video-pan-y=0.013' eDP-1 /home/maka/Pictures/wallpaper/rei.mp4"
spawn-sh-at-startup "mpvpaper -s -a full -o 'no-audio loop video-pan-y=0.007' DP-1 /home/maka/Pictures/wallpaper/rei.mp4"

environment {
    GTK_IM_MODULE "kime"
    QT_IM_MODULE "kime"
    XMODIFIERS "@im=kime"
    SDL_IM_MODULE "kime"
    INPUT_METHOD "kime"
    GLFW_IM_MODULE "kime"
    QT_IM_MODULES "wayland;kime"
    QT_QPA_PLATFORMTHEME "qt6ct"
}

output "eDP-1" {
    mode "2240x1400"
    scale 1.2
    position x=0 y=0
}

output "DP-1" {
    mode "3840x2160"
    scale 1.5
    position x=1866 y=0
}

input {
    keyboard {
        xkb {
            layout "kr"
        }
    }
    touchpad {
        tap
        dwt
        natural-scroll
    }
}

gestures {
    hot-corners {
        off
    }
}

window-rule { 
    clip-to-geometry true
    geometry-corner-radius 12
}

layout {
    gaps 10
    default-column-width { proportion 0.5; }
    focus-ring {
        off
    }
}

binds {
    Mod+R { spawn "alacritty"; }
    Mod+Space { spawn-sh "~/.config/rofi/drun.sh -show-icons"; }
    Mod+N { spawn "swaync-client" "-t" "-sw"; }
    //Mod+R { spawn-sh "cliphist list | rofi -dmenu -i -p clipboard | cliphist decode | wl-copy"; }
    //Mod+Shift+R { spawn-sh "cliphist wipe"; }
    Mod+F { spawn-sh "grim -g \"$(slurp)\" - | wl-copy"; }
    Ctrl+Shift+Escape { spawn "alacritty" "-e" "htop"; }

    Mod+L { spawn "loginctl" "lock-session"; }
    Mod+Escape { close-window; }
    Mod+Shift+Escape { quit; }

    Mod+Q { focus-column-left; }
    Mod+W { focus-column-right; }
    Mod+A { move-column-left; }
    Mod+S { move-column-right; }
    Mod+E { set-column-width "+10%"; }
    Mod+D { set-column-width "-10%"; }
    Mod+Z { maximize-column; }
    Mod+X { toggle-window-floating; }
    Mod+Shift+Q { focus-workspace-up; }
    Mod+Shift+W { focus-workspace-down; }
    Mod+Tab { spawn-sh "~/.config/niri/scripts/ws-cycle next"; }
    Mod+Ctrl+Tab { focus-monitor-next; }
    Mod+Ctrl+Q { focus-monitor-left; }
    Mod+Ctrl+W { focus-monitor-right; }
    Mod+Shift+A { move-column-to-workspace-up; }
    Mod+Shift+S { move-column-to-workspace-down; }
    Mod+Ctrl+A { move-column-to-monitor-left; }
    Mod+Ctrl+S { move-column-to-monitor-right; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.05+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.05-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "set" "10%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "10%-"; }
}
