spawn-at-startup "kime"
// 바, 알림, 배경화면, 잠금·자동 잠금, 클립보드, 권한 확인 창, 네트워크·블루투스·음량
spawn-at-startup "noctalia"
spawn-at-startup "tailscale" "systray"
spawn-at-startup "udiskie"

// 입력기(kime)·Qt 테마 환경 변수는 ~/.config/environment.d/50-kde-theme.conf에서 설정한다.
// niri가 systemd 사용자 서비스로 돌기 때문에 niri와 D-Bus로 뜨는 앱 모두에 적용된다.

output "eDP-1" {
    mode "2240x1400"
    scale 1.2
    position x=0 y=0
}

output "DP-1" {
    mode "3840x2160"
    scale 1.5
    position x=1866 y=0
}

input {
    keyboard {
        xkb {
            layout "kr"
        }
    }
    touchpad {
        tap
        dwt
        natural-scroll
    }
}

gestures {
    hot-corners {
        off
    }
}

window-rule {
    clip-to-geometry true
    geometry-corner-radius 12
}

window-rule {
    match app-id="^dev\\.noctalia\\.Noctalia$"
    open-floating true
}

debug {
    // Noctalia 알림 동작이나 창 활성화 요청이 동작하도록
    honor-xdg-activation-with-invalid-serial
}

layout {
    gaps 10
    default-column-width { proportion 0.5; }
    focus-ring {
        off
    }
}

binds {
    Mod+R { spawn "sakura"; }
    Mod+Space { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+N { spawn "noctalia" "msg" "panel-toggle" "control-center" "notifications"; }
    Mod+V { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    Mod+Comma { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+F { spawn "noctalia" "msg" "screenshot-region"; }
    Mod+Shift+F { spawn "noctalia" "msg" "screenshot-fullscreen"; }
    Ctrl+Shift+Escape { spawn "flatpak" "run" "io.missioncenter.MissionCenter"; }

    Mod+L { spawn "noctalia" "msg" "session" "lock"; }
    Mod+Escape { close-window; }
    Mod+Shift+Escape { quit; }

    Mod+Q { focus-column-left; }
    Mod+W { focus-column-right; }
    Mod+A { move-column-left; }
    Mod+S { move-column-right; }
    Mod+E { set-column-width "+10%"; }
    Mod+D { set-column-width "-10%"; }
    Mod+Z { maximize-column; }
    Mod+X { toggle-window-floating; }
    Mod+Tab { spawn-sh "~/.config/niri/scripts/ws-cycle next"; }
    Mod+Shift+Tab { spawn-sh "~/.config/niri/scripts/ws-cycle move"; }
    Mod+Ctrl+Tab { move-column-to-monitor-next; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }
}

include "noctalia.kdl"
