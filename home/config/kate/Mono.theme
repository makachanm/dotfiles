{
  "metadata": {
    "name": "Mono",
    "revision": 1,
    "author": "maka (from konsole Mono.colorscheme)",
    "license": "MIT"
  },
  "editor-colors": {
    "background-color": "#121212",
    "text-color": "#e6e6e6",
    "selection-background-color": "#333333",
    "selected-text-color": "#ffffff",
    "current-line": "#181818",
    "search-highlight": "#3a3a2c",
    "replace-highlight": "#2c3a2c",
    "bracket-matching": "#2c3c48",
    "tab-marker": "#3c3c3c",
    "spell-checking": "#c06060",
    "indentation-line": "#2c2c2c",
    "icon-border": "#161616",
    "code-folding": "#555555",
    "line-numbers": "#666666",
    "current-line-number": "#999999",
    "word-wrap-marker": "#444444",
    "modified-lines": "#a080a0",
    "saved-lines": "#7090b0",
    "separator": "#222222",
    "mark-bookmark": "#7090b0",
    "mark-breakpoint-active": "#c06060",
    "mark-breakpoint-reached": "#b0a070",
    "mark-breakpoint-disabled": "#999999",
    "mark-execution": "#80a080",
    "mark-warning": "#b0a070",
    "mark-error": "#c06060",
    "template-background": "#262626",
    "template-placeholder": "#3a3a3a",
    "template-focused-placeholder": "#4a4a4a"
  },
